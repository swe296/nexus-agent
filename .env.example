# NexusAgent Environment Configuration

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Tavily Search API Key (Free tier available at https://tavily.com/)
# If not provided, the agent falls back to DuckDuckGo search automatically.
TAVILY_API_KEY=your_tavily_api_key_here

# Model Configuration
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db
